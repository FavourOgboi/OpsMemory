[Unit]
Description=OpsMemory FastAPI backend (WhatsApp, API, agents)
Documentation=https://github.com/FavourOgboi/OpsMemory
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/root/OpsMemory/opsmemory-backend
EnvironmentFile=-/root/OpsMemory/opsmemory-backend/.env
Environment=OPSMEMORY_DB_HOST=localhost
Environment=OPSMEMORY_DB_PORT=5433
ExecStartPre=/root/OpsMemory/opsmemory-backend/venv/bin/python /root/OpsMemory/opsmemory-backend/scripts/migrate_all.py
ExecStart=/root/OpsMemory/opsmemory-backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=opsmemory-backend

[Install]
WantedBy=multi-user.target opsmemory.target
