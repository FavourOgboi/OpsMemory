[Unit]
Description=OpsMemory FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/OpsMemory/opsmemory-backend
EnvironmentFile=-/root/OpsMemory/opsmemory-backend/.env
ExecStart=/root/OpsMemory/opsmemory-backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
