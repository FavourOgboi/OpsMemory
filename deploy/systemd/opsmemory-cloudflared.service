[Unit]
Description=OpsMemory Cloudflare tunnel (webhooks)
After=network-online.target opsmemory-backend.service
Wants=network-online.target opsmemory-backend.service

[Service]
Type=simple
User=root
ExecStart=/root/OpsMemory/opsmemory-backend/scripts/cloudflared-tunnel.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
