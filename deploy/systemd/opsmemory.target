[Unit]
Description=OpsMemory production stack (API + WhatsApp tunnel)
Documentation=https://github.com/FavourOgboi/OpsMemory
After=network-online.target postgresql.service
Wants=opsmemory-backend.service opsmemory-cloudflared.service
Wants=network-online.target postgresql.service

[Install]
WantedBy=multi-user.target
