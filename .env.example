# Frontend environment (copy to .env.local — never commit .env.local)
# Vite only exposes variables prefixed with VITE_

# Backend API (use empty string in dev to use Vite proxy → localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# Clerk (optional — dashboard runs in demo mode without Clerk today)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
