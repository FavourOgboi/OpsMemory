# ╔═══════════════════════════════════════════════════════════════╗
# ║          OpsMemory — Environment Configuration              ║
# ║   Copy this file to .env and fill in your actual values     ║
# ╚═══════════════════════════════════════════════════════════════╝

# ── PostgreSQL Database (REQUIRED) ───────────────────────────────────────────
# Local: install PostgreSQL, create database 'opsmemory'
# Render: use the database credentials from your Render PostgreSQL instance
OPSMEMORY_DB_NAME=opsmemory
OPSMEMORY_DB_USER=postgres
OPSMEMORY_DB_PASSWORD=postgres
OPSMEMORY_DB_HOST=localhost
OPSMEMORY_DB_PORT=5432

# ── OpenRouter LLM API (REQUIRED for Task A + Task B) ────────────────────────
# Sign up at https://openrouter.ai/keys — $5 credit is enough for hackathon
OPENROUTER_API_KEY=sk-or-your-key-here

# ── App Security ─────────────────────────────────────────────────────────────
SECRET_KEY=opsmemory-hackathon-secret-key-change-this
APP_ENV=development
BASE_URL=http://localhost:8000

# ── WhatsApp — Meta Business API (optional — for live WhatsApp) ──────────────
META_WHATSAPP_TOKEN=
META_WHATSAPP_VERIFY_TOKEN=opsmemory_verify_2026
META_PHONE_NUMBER_ID=
META_BUSINESS_ACCOUNT_ID=

# ── Twilio Sandbox (optional — for dev WhatsApp) ─────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_VOICE_NUMBER=

# ── ElevenLabs (optional — voice TTS) ────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── SMTP Email (optional) ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=OpsMemory
SMTP_FROM_EMAIL=noreply@opsmemory.ai

# ╔═══════════════════════════════════════════════════════════════╗
# ║  DEPRECATED — No longer used (kept for reference only)      ║
# ╠═══════════════════════════════════════════════════════════════╣
# ║  Supabase: Replaced by local PostgreSQL                     ║
# ║  Clerk: Replaced by local auth (bcrypt + JWT)               ║
# ╚═══════════════════════════════════════════════════════════════╝
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWT_ISSUER=
