# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ── OpenRouter (all LLM, embeddings, transcription) ───────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_CHEAP=openai/gpt-4o-mini
OPENROUTER_MODEL_PREMIUM=anthropic/claude-sonnet-4-20250514
OPENROUTER_WHISPER_MODEL=openai/whisper-1
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# ── Clerk (JWT verification) ─────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_your-clerk-secret
CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-key
CLERK_JWT_ISSUER=https://your-clerk-domain.clerk.accounts.dev

# ── WhatsApp — Meta Business API ─────────────────────────────────────────────
META_WHATSAPP_TOKEN=your-meta-access-token
META_WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
META_PHONE_NUMBER_ID=your-phone-number-id
META_BUSINESS_ACCOUNT_ID=your-waba-id
META_GRAPH_API_VERSION=v25.0
META_APP_SECRET=your-meta-app-secret
WHATSAPP_PROVIDER=auto

# ── WhatsApp — Twilio (trial: verify recipient numbers in Twilio console) ─────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+15708431782
TWILIO_VOICE_NUMBER=+15708431782

# ── ElevenLabs (voice TTS) ───────────────────────────────────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=your-voice-id

# ── SMTP Email ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=OpsMemory
SMTP_FROM_EMAIL=noreply@opsmemory.ai

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
BASE_URL=https://your-public-backend-url.example.com
SECRET_KEY=generate-with-openssl-rand-hex-32

# ── Local PostgreSQL (optional — defaults match local dev) ───────────────────
# OPSMEMORY_DB_HOST=localhost
# OPSMEMORY_DB_PORT=5433
# OPSMEMORY_DB_NAME=opsmemory
# OPSMEMORY_DB_USER=postgres
# OPSMEMORY_DB_PASSWORD=postgres
