# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key

# ── Clerk (JWT verification) ─────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_your-clerk-secret
CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-key
CLERK_JWT_ISSUER=https://your-clerk-domain.clerk.accounts.dev

# ── WhatsApp — Meta Business API ─────────────────────────────────────────────
META_WHATSAPP_TOKEN=your-meta-token
META_WHATSAPP_VERIFY_TOKEN=opsmemory_verify_2026
META_PHONE_NUMBER_ID=your-phone-number-id
META_BUSINESS_ACCOUNT_ID=your-business-account-id

# ── WhatsApp — Twilio Sandbox (development) ──────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_VOICE_NUMBER=+1xxxxxxxxxx

# ── ElevenLabs (voice TTS) ───────────────────────────────────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=your-voice-id

# ── SMTP Email ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=OpsMemory
SMTP_FROM_EMAIL=noreply@opsmemory.ai

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
BASE_URL=https://your-backend.railway.app
SECRET_KEY=your-random-secret-key-min-32-chars
